# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web App Configuration (Required on Vercel / external hosts when firebase-applet-config.json is not committed)
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_DATABASE_ID="MY_FIRESTORE_DATABASE_ID"

# Cloudinary Configuration (Signed Uploads via Backend)
CLOUDINARY_CLOUD_NAME="MY_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="MY_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="MY_CLOUDINARY_API_SECRET"
VITE_CLOUDINARY_CLOUD_NAME="MY_CLOUDINARY_CLOUD_NAME"

# Razorpay Payment Gateway (Enable live payments only when valid merchant credentials are supplied)
RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="MY_RAZORPAY_WEBHOOK_SECRET"
VITE_RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"

# WhatsApp Cloud API (Optional — for automated WhatsApp OTP delivery at checkout)
WHATSAPP_API_TOKEN="MY_WHATSAPP_API_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"
